---
import Base from '../../../layouts/Base.astro';
import { localeCodes, useTranslations, localePath, getPageContent, pageSlugs } from '../../../lib/i18n.js';
import { site } from '../../../data/site.config.mjs';

export function getStaticPaths() {
  return localeCodes.flatMap((lang) => pageSlugs().map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params;
const t = useTranslations(lang);
const p = (...s) => localePath(lang, ...s);
const content = getPageContent(lang, slug);

const jsonLd = slug === 'faq' && content.faqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: content.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<Base lang={lang} route={`pages/${slug}`} title={content.title} description={content.lead} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={p()}>{t('nav.home')}</a><span>/</span><span>{content.title}</span>
    </nav>
  </div>

  <section class="section-tight wrap">
    <p class="eyebrow">{site.brand}</p>
    <h1>{content.title}</h1>
    <p class="lede" style="margin-top:1.2rem">{content.lead}</p>
  </section>

  <section class="wrap" style="padding-bottom:clamp(3rem,7vw,6rem)">
    <div style="display:grid;gap:clamp(2rem,5vw,4rem);grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);align-items:start">
      <div>
        {content.sections?.map((s) => (
          <article style="margin-bottom:2.2rem;max-width:70ch">
            <h2 style="font-size:clamp(1.2rem,2vw,1.5rem);margin-bottom:.7rem">{s.h}</h2>
            <p style="color:var(--ink-soft)">{s.p}</p>
          </article>
        ))}

        {content.faqs && (
          <div>
            {content.faqs.map((f, i) => (
              <details class="acc" open={i === 0}>
                <summary>{f.q}</summary>
                <div class="acc-body" style="max-width:70ch">{f.a}</div>
              </details>
            ))}
          </div>
        )}

        {slug === 'contact' && (
          <form data-contact-form style="max-width:34rem;margin-top:1rem">
            <div class="field-row">
              <label class="field"><span>{t('checkout.firstName')}</span><input name="firstName" autocomplete="given-name" required /></label>
              <label class="field"><span>{t('checkout.email')}</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <label class="field">
              <span>{t('checkout.message')}</span>
              <textarea name="message" rows="5" required></textarea>
            </label>
            <button class="btn" type="submit">{t('common.send')}</button>
            <p class="notice notice-ok" data-contact-sent hidden style="margin-top:1rem">
              {t('checkout.successBody', { email: site.email })}
            </p>
          </form>
        )}
      </div>

      <aside class="summary-box">
        <h2 style="font-size:1.15rem;margin-bottom:.9rem">{t('nav.help')}</h2>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.6rem;font-size:.9rem">
          <li><a class="link-line" href={p('pages', 'shipping')} style="text-transform:none;letter-spacing:0;font-size:inherit">{t('usp.shippingTitle')}</a></li>
          <li><a class="link-line" href={p('pages', 'returns')} style="text-transform:none;letter-spacing:0;font-size:inherit">{t('usp.returnsTitle')}</a></li>
          <li><a class="link-line" href={p('pages', 'payment')} style="text-transform:none;letter-spacing:0;font-size:inherit">{t('checkout.title')}</a></li>
          <li><a class="link-line" href={p('pages', 'faq')} style="text-transform:none;letter-spacing:0;font-size:inherit">{t('product.faq')}</a></li>
        </ul>
        <hr class="rule" style="margin-block:1.2rem" />
        <p class="small" style="margin:0">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="btn btn-ghost btn-sm btn-block" href={p('collections', 'all')} style="margin-top:1.2rem">{t('nav.shop')}</a>
      </aside>
    </div>
  </section>

  <script define:vars={{ to: site.email }}>
    const form = document.querySelector('[data-contact-form]');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const values = Object.fromEntries(new FormData(form));
        const body = `${values.firstName} <${values.email}>\n\n${values.message}`;
        window.location.href = `mailto:${to}?subject=${encodeURIComponent('Contact — lamaisonvaldor.com')}&body=${encodeURIComponent(body)}`;
        form.querySelector('[data-contact-sent]').hidden = false;
      });
    }
  </script>
</Base>
