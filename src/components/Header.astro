---
import { localePath, useTranslations } from '../lib/i18n.js';
import { locales, currencies, site } from '../data/site.config.mjs';

const { lang, alternates = {} } = Astro.props;
const t = useTranslations(lang);
const p = (...s) => localePath(lang, ...s);
const current = Astro.url.pathname;

const nav = [
  { href: p('collections', 'all'), label: t('nav.shop') },
  { href: p('collections'), label: t('nav.collections') },
  { href: p('pages', 'about'), label: t('nav.about') },
  { href: p('pages', 'contact'), label: t('nav.contact') },
];
---
<header class="header">
  <div class="wrap header-bar">
    <button class="icon-btn menu-toggle" data-toggle="#site-nav" aria-expanded="false" aria-controls="site-nav">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M1 4h16M1 9h16M1 14h16" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
      <span class="visually-hidden">{t('nav.menu')}</span>
    </button>

    <a class="brand" href={p()}>
      La Maison Val d’Or
      <span>{site.domain}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t('nav.menu')}>
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={p('search')} aria-label={t('nav.search')}>
        <svg width="17" height="17" viewBox="0 0 18 18" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M12.5 12.5 17 17" stroke="currentColor" stroke-width="1.2"/></svg>
      </a>

      <details class="switch">
        <summary aria-label={t('common.currency')}><span data-currency-code>EUR</span></summary>
        <div class="switch-panel">
          {currencies.map((c) => (
            <button type="button" data-set-currency={c.code} data-currency-active={c.code}>
              <span style="width:2.6rem">{c.code}</span>
              <span class="muted small">{c.symbol}</span>
            </button>
          ))}
        </div>
      </details>

      <details class="switch">
        <summary aria-label={t('common.language')}>{lang.toUpperCase()}</summary>
        <div class="switch-panel">
          {locales.map((l) => (
            <a
              href={alternates[l.code] || localePath(l.code)}
              hreflang={l.hreflang}
              lang={l.code}
              data-set-lang={l.code}
              aria-current={l.code === lang ? 'true' : undefined}
            >
              <span aria-hidden="true">{l.flag}</span>
              <span>{l.native}</span>
            </a>
          ))}
        </div>
      </details>

      <a class="icon-btn" href={p('cart')} aria-label={t('nav.cart')}>
        <svg width="17" height="17" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 5h12l-1 11H4L3 5Z" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M6.5 7V4.5a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>
</header>
