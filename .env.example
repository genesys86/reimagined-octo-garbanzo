# Copy to .env for local runs, or set these in your host's dashboard.
# Nothing here is required to build and deploy the site.

# Canonical origin used for <link rel=canonical>, hreflang and the sitemap.
SITE_URL=https://lamaisonvaldor.com

# 'enquiry' (default) turns the bag into a concierge request handled by email.
# 'stripe' posts the bag to /api/checkout and redirects to Stripe Checkout.
PUBLIC_CHECKOUT_MODE=enquiry

# Server-side only, read by functions/api/checkout.js. Never expose these.
STRIPE_SECRET_KEY=
SITE_ORIGIN=https://lamaisonvaldor.com
# Optional: map a discount code to a Stripe coupon id, one variable per code.
# STRIPE_COUPON_WELCOME10=

# Product-copy translation (npm run translate). The UI and the legal pages are
# hand-translated and need no key.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5

# Override the FX source used by npm run rates.
EXCHANGE_RATE_API_URL=

# Prices above this (in the base currency) are flagged during import and kept
# out of the home page rails until a human checks them against the supplier.
PRICE_REVIEW_CEILING=250000
